@@ -0,0 +1,14 @@
+// Synthetic fixtures: known settings, zeroed unrelated fields, no real appliance capture.
+import AABBDevice from '@/cloud/devices/aabb_device'
+export function makeWasherFrame(options: {drying?:number;spin?:number;temp?:number;duration?:number}={}) {
+    const state=Buffer.alloc(39)
+    state[2]=1;state[7]=1;state[9]=3;state[10]=options.spin??10;state[11]=options.temp??4
+    state[12]=1;state[13]=options.drying??0
+    const minutes=options.duration??238
+    state[3]=state[5]=Math.floor(minutes/60);state[4]=state[6]=minutes%60
+    const header=Buffer.from('200a005b000102000100ec004e','hex')
+    return AABBDevice.frame(Buffer.concat([header,Buffer.alloc(39),state]))
+}
+export function makeConfigFrame() {
+    return AABBDevice.frame(Buffer.from('200a0015000102000101030003000000','hex'))
+}
