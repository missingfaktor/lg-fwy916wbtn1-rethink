@@ -0,0 +1,148 @@
+import HADevice from './base'
+import AABBDevice from './aabb_device'
+import { Device as Thinq2Device } from '../thinq2/device'
+import { type Connection } from '../homeassistant'
+import { type Metadata } from '../thinq'
+import { allowExtendedType } from '@/util/casting'
+import { TEMPERATURES, SPINS } from './washer_common'
+import { createHash, randomUUID } from 'node:crypto'
+
+export const DRYING_CHOICES = [
+    {id:'off',label:'Off',code:0}, {id:'cupboard',label:'Cupboard',code:2},
+    {id:'iron',label:'Iron',code:10}, {id:'low-temperature',label:'Low Temperature',code:11},
+    {id:'cupboard-plus',label:'Cupboard+',code:12},
+    {id:'30-min',label:'30 minutes',code:3}, {id:'60-min',label:'60 minutes',code:4},
+    {id:'120-min',label:'120 minutes',code:6},
+] as const
+export type Drying = typeof DRYING_CHOICES[number]['id']
+export type ProgrammeSelection = {programme:string;temperatureC:number|null;spinRpm:number|null;drying:Drying}
+export type ProgrammeDefinition = {
+    id:string;label:string;code:number;temperatures:(number|null)[];spins:(number|null)[];
+    drying:Drying[];defaults:Omit<ProgrammeSelection,'programme'>;soil:number;rinse:number;options:number;
+}
+const ALL_TEMPS=[0,20,30,40,60,95]
+const ALL_SPINS=[0,400,800,1000,1200,1400]
+const ALL_DRY=DRYING_CHOICES.map(x=>x.id)
+const definition=(id:string,label:string,code:number,temperatures:(number|null)[],spins:(number|null)[],
+    dry:boolean,temperatureC:number|null,spinRpm:number|null,drying:Drying='off',options=0):ProgrammeDefinition=>({
+    id,label,code,temperatures,spins,drying:dry?ALL_DRY:['off'],defaults:{temperatureC,spinRpm,drying},
+    soil:3,rinse:1,options,
+})
+// Limits/defaults follow the FWY916WBTN1 manual. Wire programme IDs use the B32 family;
+// Cotton/Eco were observed on this unit; other execution paths remain offline-tested only.
+export const PROGRAMMES: ProgrammeDefinition[] = [
+    definition('wash-dry','Wash+Dry',0x13,ALL_TEMPS,[1000,1200,1400],true,40,1400,'cupboard'),
+    definition('cotton','Cotton',1,ALL_TEMPS,ALL_SPINS,true,40,1400),
+    definition('eco-40-60','Eco 40-60',4,[40,60],ALL_SPINS,true,40,1400),
+    definition('turbo-wash-39','TurboWash 39',0x31,[0,20,30,40,60],[400,800,1000,1200,1400],true,40,1200,'off',1),
+    definition('mixed-fabric','Mixed Fabric',7,[0,20,30,40,60],ALL_SPINS,true,40,1000),
+    definition('easy-care','Easy Care',2,[0,20,30,40,60],ALL_SPINS,true,40,1400),
+    definition('allergy-care','Allergy Care',0x2d,[60],ALL_SPINS,true,60,1400,'off',0x80),
+    definition('ai-wash','AI Wash',0x3a,[0,20,30,40,60],ALL_SPINS,false,40,1400),
+    definition('delicates','Delicates',0x20,[0,20,30,40],[0,400,800],false,20,800),
+    definition('hand-wool','Hand/Wool',0x1b,[0,20,30,40],[0,400,800],false,30,800),
+    definition('speed-14','Speed 14',0x0c,[20,30,40],ALL_SPINS,true,20,400,'off',1),
+    {...definition('dry-only','Dry Only',0x18,[null],[1000,1200,1400],true,null,1400,'cupboard'),soil:0,rinse:0},
+    {...definition('tub-clean','Tub Clean (empty drum)',0x12,[null],[null],false,null,null),soil:0,rinse:0},
+]
+PROGRAMMES.filter(p=>['wash-dry','dry-only'].includes(p.id)).forEach(p=>{p.drying=p.drying.filter(x=>x!=='off')})
+export function normaliseSelection(input:unknown):ProgrammeSelection {
+    if(!input || typeof input!=='object' || Array.isArray(input)) throw new Error('Supply programme settings as an object.')
+    const value=input as Record<string,unknown>
+    const allowed=new Set(['programme','temperatureC','spinRpm','drying'])
+    if(Object.keys(value).some(k=>!allowed.has(k))) throw new Error('Unknown setting. Use programme, temperatureC, spinRpm and drying.')
+    const p=PROGRAMMES.find(p=>p.id===value.programme)
+    if(!p) throw new Error('Choose a supported programme.')
+    const t=value.temperatureC===undefined?p.defaults.temperatureC:value.temperatureC
+    const spin=value.spinRpm===undefined?p.defaults.spinRpm:value.spinRpm
+    const dry=value.drying===undefined?p.defaults.drying:value.drying
+    if(!p.temperatures.includes(t as number|null)) throw new Error('That temperature is not available for this programme.')
+    if(!p.spins.includes(spin as number|null)) throw new Error('That spin speed is not available for this programme.')
+    if(!p.drying.includes(dry as Drying)) throw new Error('That drying setting is not available for this programme.')
+    if(dry!=='off' && typeof spin==='number' && spin<1000) throw new Error('Select at least 1000 rpm when adding drying.')
+    return {programme:p.id,temperatureC:t as number|null,spinRpm:spin as number|null,drying:dry as Drying}
+}
+const tempCode=(t:number|null)=>t===null?0:t===0?1:({20:2,30:3,40:4,60:6,95:7} as Record<number,number>)[t]
+const spinCode=(n:number|null)=>n===null?0:({0:1,400:2,800:5,1000:7,1200:9,1400:10} as Record<number,number>)[n]
+const STATE:Record<number,string>={0:'Off',1:'Standby',2:'Paused',3:'Delayed',4:'Detecting',6:'Washing',7:'Rinsing',8:'Spinning',9:'Drying',10:'Finished',11:'Cooling down',18:'Error'}
+export type StartPreview={enabled:boolean;reason:string|null;revision?:string;command?:string;source?:'laptop'|'washer'}
+
+export default class Device extends AABBDevice {
+    receivedPackets=0
+    private reportedState?:Buffer
+    private reportedVersion=0
+    private startRequestedVersion?:number
+    private readonly session=randomUUID()
+    private selection?:ProgrammeSelection
+    constructor(HA:Connection,thinq:Thinq2Device,meta:Metadata,private readonly now=Date.now){
+        super(HA,thinq,true)
+        this.setConfig(allowExtendedType({
+            ...HADevice.config(meta,{name:'LG Washer Dryer'}),
+            components:{
+                ...Object.fromEntries([['status','Status'],['course','Programme'],['temp','Temperature'],['spin','Spin speed'],['drying_mode','Drying']]
+                    .map(([key,name])=>[key,{platform:'sensor',unique_id:'$deviceid-'+key,name,state_topic:'$this/'+key}])),
+                received_packets:{platform:'sensor',unique_id:'$deviceid-received-packets',name:'Received packets',state_topic:'$this/received_packets',entity_category:'diagnostic'},
+            },
+        }))
+    }
+    processAABB(buf:Buffer){
+        this.publishProperty('received_packets',++this.receivedPackets)
+        this.publishProperty('raw_packet',buf.toString('hex'))
+        this.processEnvelopedStatus(buf,0x20,39,this.processState)
+    }
+    processState(s:Buffer){
+        if(s.length!==39)return
+        if(!this.reportedState?.equals(s))this.reportedVersion++
+        this.reportedState=Buffer.from(s)
+        this.publishProperty('last_status_at',new Date(this.now()).toISOString())
+        this.publishProperty('status',STATE[s[2]]??`State code ${s[2]}`)
+        this.publishProperty('power',s[2]===0?'OFF':'ON')
+        this.publishProperty('course',s[7]===0?'Not selected':PROGRAMMES.find(p=>p.code===s[7])?.label??`Programme code 0x${s[7].toString(16)}`)
+        this.publishProperty('spin',SPINS.map(s[10])??`Spin code ${s[10]}`)
+        this.publishProperty('temp',TEMPERATURES.map(s[11])??`Temperature code ${s[11]}`)
+        this.publishProperty('drying_mode',DRYING_CHOICES.find(d=>d.code===s[13])?.label??`Drying code ${s[13]}`)
+        this.publishProperty('initial_time',s[5]*60+s[6]);this.publishProperty('remaining_time',s[3]*60+s[4])
+        this.publishProperty('error_code',s[8])
+        // Panel-verified on this exact model: Add Item changed 00 -> 02 -> 42 while idle.
+        this.publishProperty('remote_start',s[17]&2?'ON':'OFF')
+    }
+    getSelection(){return this.selection?{...this.selection}:null}
+    selectProgramme(input:unknown){
+        this.selection=normaliseSelection(input)
+        return this.getSelection()
+    }
+    previewStart():StartPreview{
+        const s=this.reportedState
+        const no=(reason:string):StartPreview=>({enabled:false,reason})
+        if(!s)return no('Power on the washer and arm Remote Start to report its ready state.')
+        if(this.startRequestedVersion===this.reportedVersion)return no('Start was already requested. Check the washer before trying again.')
+        if(s[2]!==1)return no('The washer must be on and in standby.')
+        if(s[8]!==0)return no('Clear the error shown on the washer first.')
+        if(!(s[17]&2))return no('Arm Remote Start on the washer by holding Add Item for 3 seconds.')
+        let command:Buffer
+        if(this.selection){
+            const selection=normaliseSelection(this.selection)
+            const p=PROGRAMMES.find(p=>p.id===selection.programme)!
+            const dry=DRYING_CHOICES.find(d=>d.id===selection.drying)!.code
+            command=Buffer.from([0xf0,0x26,p.code,p.soil,spinCode(selection.spinRpm),tempCode(selection.temperatureC),p.rinse,dry,0,0,0,p.options,3,0,0,0,0,0])
+        }else{
+            if(s[7]===0||s[10]===0||s[11]===0||s[12]===0)return no('Choose a programme in Next wash.')
+            if(s[22]!==0)return no('Choose a standard programme in Next wash instead of a downloaded cycle.')
+            command=Buffer.from([0xf0,0x26,s[7],s[9],s[10],s[11],s[12],s[13],s[14],s[15],0,s[16],3,0,0,0,0,0])
+        }
+        // A physical state change invalidates an earlier review, including changes to arming.
+        const revision=createHash('sha256').update(this.session).update(String(this.reportedVersion)).update(command).digest('hex')
+        return {enabled:true,reason:null,revision,command:command.toString('hex'),source:this.selection?'laptop':'washer'}
+    }
+    startSelectedProgramme(expectedRevision:string){
+        const plan=this.previewStart()
+        if(!plan.enabled||!plan.command)throw new Error(plan.reason??'Start is unavailable.')
+        if(plan.revision!==expectedRevision)throw new Error('Programme or washer state changed. Review the current selection before starting.')
+        this.startRequestedVersion=this.reportedVersion
+        try{this.send(Buffer.from(plan.command,'hex'))}catch(error){this.startRequestedVersion=undefined;throw error}
+    }
+    drop(){this.reportedState=undefined;super.drop()}
+    setProperty(_prop:string,_value:string){
+        // An old/retained MQTT message must never initiate Start. Use the explicit HTTP action.
+    }
+}
