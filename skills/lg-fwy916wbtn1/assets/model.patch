index 0000000..b204058
--- /dev/null
+++ b/cloud/devices/Y_V8_F___W.B32QEUK.ts
@@ -0,0 +1,119 @@
+import HADevice from './base'
+import AABBDevice from './aabb_device'
+import { Device as Thinq2Device } from '../thinq2/device'
+import { type Connection } from '../homeassistant'
+import { type Metadata } from '../thinq'
+import { allowExtendedType } from '@/util/casting'
+import { TEMPERATURES, SPINS } from './washer_common'
+import { createHash, randomUUID } from 'node:crypto'
+
+export type StartPreview = {
+    enabled: boolean
+    reason: string | null
+    revision?: string
+    command?: string
+}
+
+// Local trial: FWY916WBTN1, RTL8720cm 2.11.207, protocol 4.9 in SoftAP.
+// Verified on this unit by power off/on, Cotton 40 C / 1400 rpm, and toggling Dry.
+// Status uses the 39-byte record shared by this model's immediate siblings.
+// Course tables are model-specific; keep unconfirmed codes visibly numeric.
+const COURSES: Record<number,string> = {0:'Not selected', 1:'Cotton'}
+const STATES: Record<number,string> = {0:'Off',1:'Standby'}
+const DRYING: Record<number,string> = {0:'Off',2:'On (automatic)'}
+export default class Device extends AABBDevice {
+    receivedPackets = 0
+    private reportedState?: Buffer
+    private reportedAt = 0
+    private reportedVersion = 0
+    private startRequestedVersion?: number
+    private readonly session = randomUUID()
+    constructor(HA: Connection, thinq: Thinq2Device, meta: Metadata, private readonly now = Date.now) {
+        super(HA, thinq, true)
+        this.setConfig(allowExtendedType({
+            ...HADevice.config(meta, { name: 'LG Washer Dryer' }),
+            components: {
+                ...Object.fromEntries([
+                    ['status','Status'],['course','Programme'],['temp','Temperature'],
+                    ['spin','Spin speed'],['drying_mode','Drying'],
+                ].map(([key,name])=>[key,{platform:'sensor',unique_id:'$deviceid-'+key,name,state_topic:'$this/'+key}])),
+                ...Object.fromEntries([
+                    ['initial_time','Selected programme time'],['remaining_time','Remaining time'],
+                ].map(([key,name])=>[key,{platform:'sensor',unique_id:'$deviceid-'+key,name,state_topic:'$this/'+key,
+                    device_class:'duration',unit_of_measurement:'min'}])),
+                received_packets: {
+                    platform: 'sensor',
+                    unique_id: '$deviceid-received-packets',
+                    name: 'Received packets',
+                    state_topic: '$this/received_packets',
+                    entity_category: 'diagnostic',
+                },
+            },
+        }))
+    }
+
+    processAABB(buf: Buffer) {
+        this.publishProperty('received_packets', ++this.receivedPackets)
+        this.publishProperty('raw_packet', buf.toString('hex'))
+        this.processEnvelopedStatus(buf,0x20,39,this.processState)
+    }
+
+    processState(s: Buffer) {
+        if (s.length !== 39) return
+        if (!this.reportedState?.equals(s)) this.reportedVersion++
+        this.reportedState = Buffer.from(s)
+        this.reportedAt = this.now()
+        this.publishProperty('last_status_at',new Date(this.reportedAt).toISOString())
+        this.publishProperty('status',STATES[s[2]] ?? `State code ${s[2]}`)
+        this.publishProperty('power',s[2]===0?'OFF':'ON')
+        this.publishProperty('course',COURSES[s[7]] ?? `Programme code 0x${s[7].toString(16)}`)
+        this.publishProperty('spin',SPINS.map(s[10]) ?? `Spin code ${s[10]}`)
+        this.publishProperty('temp',TEMPERATURES.map(s[11]) ?? `Temperature code ${s[11]}`)
+        this.publishProperty('drying_mode',DRYING[s[13]] ?? `Drying code 0x${s[13].toString(16)}`)
+        this.publishProperty('initial_time',s[5]*60+s[6])
+        this.publishProperty('remaining_time',s[3]*60+s[4])
+        this.publishProperty('error_code',s[8])
+    }
+
+    /** Pure preview: generating or reading it never sends anything to the appliance. */
+    previewStart(): StartPreview {
+        const s = this.reportedState
+        const unavailable = (reason: string): StartPreview => ({enabled:false,reason})
+        if (!s) return unavailable('Select a programme on the washer to load its settings.')
+        if (this.now() - this.reportedAt > 120_000) return unavailable('Refresh the programme settings on the washer.')
+        if (this.startRequestedVersion === this.reportedVersion) return unavailable('Start was already requested. Check the washer or refresh its settings.')
+        if (s[2] !== 1) return unavailable('The washer must be on and in standby.')
+        if (s[8] !== 0) return unavailable('Clear the error shown on the washer first.')
+        if (s[7] === 0 || s[10] === 0 || s[11] === 0 || s[12] === 0) return unavailable('Select a complete programme on the washer.')
+        if (s[22] !== 0) return unavailable('Start for downloaded programmes is not implemented yet.')
+
+        // B32 WMStart layout from upstream Y_V8_Y___W.B32QEUK.programmeCommand.
+        // Keep the drying level from this combo's report instead of its wash-only sibling's 0.
+        // Unlike F02405 (default programme), F026 carries the selected programme and all settings.
+        const command = Buffer.from([
+            0xf0,0x26,s[7],s[9],s[10],s[11],s[12],s[13],s[14],s[15],0,s[16],
+            0x03,0,0,0,0,0, // initialBit|remoteStart, reserved, smart course and absent ezDispense
+        ])
+        const revision = createHash('sha256').update(this.session).update(command).digest('hex')
+        return {enabled:true,reason:null,revision,command:command.toString('hex')}
+    }
+
+    /** Only the explicit Start action calls this; no constructor, timer or receive path does. */
+    startSelectedProgramme(expectedRevision: string) {
+        const plan = this.previewStart()
+        if (!plan.enabled || !plan.command) throw new Error(plan.reason ?? 'Start is unavailable.')
+        if (plan.revision !== expectedRevision) throw new Error('Programme settings changed. Review them before starting.')
+        this.startRequestedVersion = this.reportedVersion
+        try {
+            this.send(Buffer.from(plan.command,'hex'))
+        } catch (error) {
+            this.startRequestedVersion = undefined
+            throw error
+        }
+    }
+
+    setProperty(_prop: string, _value: string) {
+        // No MQTT command subscription: old/retained messages must not trigger a start.
+        // The local page uses startSelectedProgramme with a reviewed-settings revision.
+    }
+}
