@@ -0,0 +1,140 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import Device, { PROGRAMMES,normaliseSelection } from '@/cloud/devices/Y_V8_F___W.B32QEUK'
+import { MockHAConnection, MockThinq2Device } from '@/tests/helpers/mocks'
+
+import { makeWasherFrame, makeConfigFrame } from '@/tests/helpers/fwy916wbtn1-fixtures'
+
+const META={modelId:'Y_V8_F___W.B32QEUK',modelName:'FWY916WBTN1',swVersion:'2.11.207'}
+// Generated fixtures model the panel-verified layout without redistributing captures.
+const FRAME=makeConfigFrame()
+const COTTON_40_1400=makeWasherFrame()
+const COTTON_DRY_ON=makeWasherFrame({drying:2,duration:362})
+const COTTON_30_1000=makeWasherFrame({drying:2,spin:7,temp:3,duration:338})
+
+test('captured FWY916WBTN1 envelope is acknowledged without an appliance command',()=>{
+    const ha=new MockHAConnection()
+    const thinq=new MockThinq2Device('test-washer',META)
+    new Device(ha.asConnection(),thinq,META)
+    thinq.emit('data',FRAME)
+    assert.deepEqual(thinq.sent,[{cmd:'ack',type:1,data:'AA0AF0000A040102E0BB'}])
+    assert.equal(ha.devices['test-washer'].properties.received_packets,1)
+    assert.equal(ha.devices['test-washer'].properties.raw_packet,FRAME.subarray(2,-2).toString('hex'))
+    assert.equal(ha.devices['test-washer'].properties.status,undefined)
+})
+
+test('MQTT messages cannot start, pause, stop or power the washer',()=>{
+    const ha=new MockHAConnection()
+    const thinq=new MockThinq2Device('test-washer',META)
+    const device=new Device(ha.asConnection(),thinq,META)
+    for(const key of ['start','pause','stop','power'])device.setProperty(key,'ON')
+    assert.deepEqual(thinq.sent,[])
+    const components=ha.devices['test-washer'].config!.components
+    for(const component of Object.values(components))assert.equal('command_topic' in component,false)
+})
+
+test('previews and incoming status never transmit a start; explicit action preserves settings',()=>{
+    const ha=new MockHAConnection()
+    const thinq=new MockThinq2Device('test-washer',META)
+    const device=new Device(ha.asConnection(),thinq,META)
+    assert.equal(device.previewStart().enabled,false)
+    assert.equal(thinq.outbox.length,0)
+    for(const [frame,expected] of [
+        [COTTON_40_1400,'f02601030a04010000000000030000000000'],
+        [COTTON_DRY_ON,'f02601030a04010200000000030000000000'],
+        [COTTON_30_1000,'f02601030703010200000000030000000000'],
+    ] as const){
+        thinq.emit('data',frame)
+        const plan=device.previewStart()
+        assert.equal(plan.enabled,true)
+        assert.equal(plan.command,expected)
+        assert.equal(device.previewStart().revision,plan.revision)
+        assert.equal(thinq.outbox.length,0,'receive and preview are read-only')
+    }
+    const plan=device.previewStart()
+    device.startSelectedProgramme(plan.revision!)
+    assert.equal(thinq.outbox.length,1)
+    assert.equal(thinq.outbox[0].subarray(2,-2).toString('hex'),'f02601030703010200000000030000000000')
+    assert.throws(()=>device.startSelectedProgramme(plan.revision!),/already requested/)
+    thinq.emit('data',COTTON_30_1000)
+    assert.throws(()=>device.startSelectedProgramme(plan.revision!),/already requested/,'a repeated status does not permit a duplicate')
+    assert.equal(thinq.outbox.length,1)
+})
+
+test('unarmed, changed, incomplete, non-standby and errored selections cannot start',()=>{
+    const ha=new MockHAConnection();const thinq=new MockThinq2Device('test-washer',META)
+    const device=new Device(ha.asConnection(),thinq,META)
+    assert.throws(()=>device.startSelectedProgramme('anything'),/Power on/)
+    thinq.emit('data',COTTON_40_1400);const old=device.previewStart()
+    thinq.emit('data',COTTON_DRY_ON)
+    assert.throws(()=>device.startSelectedProgramme(old.revision!),/changed/)
+    const record=COTTON_DRY_ON.subarray(54,93)
+    for(const[index,value,reason]of [[2,6,/standby/],[8,3,/error/],[7,0,/Next wash/],[22,1,/downloaded/],[17,0,/Remote Start/]]as const){
+        const s=Buffer.from(record);s[index]=value;device.processState(s)
+        assert.throws(()=>device.startSelectedProgramme('anything'),reason)
+    }
+    assert.equal(thinq.outbox.length,0)
+})
+
+test('real panel changes decode the current state of paired status records',()=>{
+    const ha=new MockHAConnection()
+    const thinq=new MockThinq2Device('test-washer',META)
+    new Device(ha.asConnection(),thinq,META)
+    const props=()=>ha.devices['test-washer'].properties
+    thinq.emit('data',COTTON_40_1400)
+    assert.equal(props().status,'Standby')
+    assert.equal(props().course,'Cotton')
+    assert.equal(props().temp,'40 °C')
+    assert.equal(props().spin,'1400 rpm')
+    assert.equal(props().drying_mode,'Off')
+    assert.equal(props().remaining_time,238)
+    thinq.emit('data',COTTON_DRY_ON)
+    assert.equal(props().drying_mode,'Cupboard')
+    assert.equal(props().remaining_time,362)
+    thinq.emit('data',COTTON_30_1000)
+    assert.equal(props().temp,'30 °C')
+    assert.equal(props().spin,'1000 rpm')
+    assert.equal(props().drying_mode,'Cupboard')
+    assert.equal(props().initial_time,338)
+    assert.equal(props().remaining_time,338)
+    assert.equal(thinq.sent.every(message=>message.cmd==='ack'),true)
+})
+
+test('laptop choices work without a physical programme selection and plan changes never actuate',()=>{
+    const ha=new MockHAConnection();const thinq=new MockThinq2Device('test-washer',META)
+    const device=new Device(ha.asConnection(),thinq,META)
+    thinq.emit('data',makeWasherFrame({course:0}))
+    assert.equal(device.previewStart().enabled,false)
+    device.selectProgramme({programme:'wash-dry',temperatureC:40,spinRpm:1400,drying:'cupboard'})
+    const plan=device.previewStart()
+    assert.equal(plan.enabled,true);assert.equal(plan.source,'laptop')
+    assert.equal(plan.command,'f02613030a04010200000000030000000000')
+    assert.equal(thinq.outbox.length,0)
+    device.selectProgramme({programme:'cotton',temperatureC:30,spinRpm:1000,drying:'off'})
+    assert.throws(()=>device.startSelectedProgramme(plan.revision!),/changed/)
+    assert.equal(thinq.outbox.length,0)
+    device.startSelectedProgramme(device.previewStart().revision!)
+    assert.equal(thinq.outbox.length,1)
+    assert.equal(thinq.outbox[0].subarray(2,-2).toString('hex'),'f02601030703010000000000030000000000')
+})
+
+test('programme constraints reject wool drying, excessive spin and incompatible temperatures',()=>{
+    for(const p of PROGRAMMES)assert.deepEqual(normaliseSelection({programme:p.id}),{programme:p.id,...p.defaults})
+    for(const input of [
+        {programme:'hand-wool',drying:'cupboard'}, {programme:'delicates',spinRpm:1400},
+        {programme:'allergy-care',temperatureC:30}, {programme:'cotton',drying:'cupboard',spinRpm:800},
+        {programme:'wash-dry',drying:'off'}, {programme:'not-a-programme'},
+    ])assert.throws(()=>normaliseSelection(input))
+})
+
+test('physical arming is required and disconnect invalidates a previously reviewed plan',()=>{
+    const ha=new MockHAConnection();const thinq=new MockThinq2Device('test-washer',META)
+    const device=new Device(ha.asConnection(),thinq,META)
+    device.selectProgramme({programme:'wash-dry'})
+    thinq.emit('data',makeWasherFrame({armed:false,course:0}))
+    assert.match(device.previewStart().reason!,/Remote Start/)
+    thinq.emit('data',makeWasherFrame({armed:true,course:0}))
+    const ready=device.previewStart();assert.equal(ready.enabled,true)
+    device.drop();assert.throws(()=>device.startSelectedProgramme(ready.revision!),/Power on/)
+    assert.equal(thinq.outbox.length,0)
+})
